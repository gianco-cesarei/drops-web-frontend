---
import { publishedContentItems } from '../../data/content.data'
import { categoryLabels, isProducerVerified } from '../../domain/discovery'
import PublicLayout from '../../layouts/PublicLayout.astro'

export function getStaticPaths() {
  return publishedContentItems.map((item) => ({
    params: { slug: item.slug },
    props: { item },
  }))
}

const { item } = Astro.props
const body = item.body ?? []
const hasBody = body.length > 0
const primaryDirectSource = item.sources.find((source) => source.kind === 'original') ?? item.sources[0]
const otherSources = item.sources.filter((source) => source !== primaryDirectSource)
const kicker = item.kicker ?? (item.tags.includes('guida') ? 'Guida' : categoryLabels[item.type])
const published = new Intl.DateTimeFormat('it', { dateStyle: 'long' }).format(new Date(item.publishedAt))
const producer = item.producerProfile
const isProducer = Boolean(producer)
const producerVerified = isProducerVerified(producer)
const xpPercent = producer ? Math.min(100, Math.round((producer.xpCurrent / (producer.xpNext || 1000)) * 100)) : 0
---

<PublicLayout title={`${item.title} ${producerVerified ? '✓' : ''} — Drops`} description={item.summary}>
  <main class="public-main article-page-container">
    <div class="article-layout-grid">
      <!-- COLONNA SINISTRA: STICKY (Cover + CTA Primaria + Piattaforme + Metadati) -->
      <aside class="article-sidebar-sticky">
        <a href="/" class="back-to-catalog">← Torna a Discovery</a>

        <div class="article-cover-wrap">
          {item.coverUrl ? (
            <img src={item.coverUrl} alt={item.title} class="article-cover-img" />
          ) : (
            <div class={`article-cover-fallback type-${item.type.toLowerCase()}`}>
              <span class="fallback-kicker">{kicker}</span>
              <span class="fallback-brand">Drops</span>
            </div>
          )}
        </div>

        {isProducer && producerVerified && (
          <div class="sidebar-verified-pill">
            <span class="v-icon">✓</span>
            <span>Profilo Esterno Connesso</span>
          </div>
        )}

        <!-- PULSANTE PRINCIPALE DIRETTO SUBITO SOTTO L'IMMAGINE -->
        <a class="primary-direct-cta" href={primaryDirectSource.url} target="_blank" rel="noreferrer">
          <span class="cta-label">{primaryDirectSource.label}</span>
          <span class="cta-arrow">↗</span>
        </a>

        {/* SOCIAL & MUSIC LINKS */}
        {producer?.socialLinks && producer.socialLinks.length > 0 && (
          <div class="sidebar-box platforms-box">
            <span class="box-title">Profili & Piattaforme:</span>
            <div class="platforms-list">
              {producer.socialLinks.map((s) => (
                <a class={`source-chip ${s.connectedForVerification ? 'chip-verified' : ''}`} href={s.url} target="_blank" rel="noreferrer">
                  <span>{s.label}</span>
                  {s.connectedForVerification && <span class="v-tick">✓</span>}
                  <span class="chip-arrow">↗</span>
                </a>
              ))}
            </div>
          </div>
        )}

        {otherSources.length > 0 && !producer && (
          <div class="sidebar-box platforms-box">
            <span class="box-title">Altre piattaforme & fonti:</span>
            <div class="platforms-list">
              {otherSources.map((source) => (
                <a class="source-chip" href={source.url} target="_blank" rel="noreferrer">
                  {source.label} ↗
                </a>
              ))}
            </div>
          </div>
        )}

        <div class="sidebar-box meta-box">
          <dl class="meta-list">
            {isProducer && producer?.daw && (
              <div>
                <dt>DAW in Studio</dt>
                <dd class="daw-tag">🎹 {producer.daw}</dd>
              </div>
            )}
            <div>
              <dt>Luogo</dt>
              <dd>📍 {item.primaryLocation.name}</dd>
            </div>
            {isProducer && producer?.genres && producer.genres.length > 0 && (
              <div>
                <dt>Generi</dt>
                <dd class="tags-row">{producer.genres.join(' · ')}</dd>
              </div>
            )}
            <div>
              <dt>Su Drops da</dt>
              <dd>{published}</dd>
            </div>
            {item.tags && item.tags.length > 0 && (
              <div>
                <dt>Tag</dt>
                <dd class="tags-row">{item.tags.join(' · ')}</dd>
              </div>
            )}
          </dl>
        </div>
      </aside>

      <!-- COLONNA DESTRA: SCROLLABILE (Kicker + Titolo + Standfirst + Corpo Articolo) -->
      <section class="article-content-scrollable">
        <div class="kicker-badge-row">
          <span class="article-kicker">{kicker}</span>
          {isProducer && <span class="badge-new-pill">NEW PRODUCER</span>}
        </div>

        <h1 class="article-headline artist-headline">
          {item.title}
          {isProducer && producerVerified && (
            <span class="verified-badge-large" title="Profilo Verificato: almeno un account esterno connesso">✓</span>
          )}
        </h1>

        {/* PRODUCER LEVEL CARD */}
        {isProducer && producer && (
          <div class="producer-level-hero-card">
            <div class="level-top-row">
              <div class="level-badge-visual">
                <span class="lvl-num">0{producer.levelNumber}</span>
                <span class="lvl-name">{producer.level}</span>
              </div>
              <div class="xp-numeric-badge">
                <strong>{producer.xpCurrent.toLocaleString('it')}</strong> / {producer.xpNext.toLocaleString('it')} XP
              </div>
            </div>
            <div class="xp-hero-bar">
              <div class="xp-hero-fill" style={`width: ${xpPercent}%`}></div>
            </div>
            <div class="xp-hero-footer">
              <span>Progresso Livello: {xpPercent}%</span>
              <span>{(producer.xpNext - producer.xpCurrent).toLocaleString('it')} XP al prossimo status</span>
            </div>
          </div>
        )}

        <p class="article-standfirst">{item.summary}</p>

        {/* PRODUCER STATS EDITORIALI (GRANDI NUMERI) */}
        {isProducer && producer?.stats && (
          <div class="producer-editorial-stats">
            <div class="stat-editorial-item">
              <span class="stat-number">{String(producer.stats.tracks).padStart(2, '0')}</span>
              <span class="stat-label">TRACCE PUBBLICATE</span>
            </div>
            <div class="stat-editorial-item">
              <span class="stat-number">{String(producer.stats.votesReceived).padStart(2, '0')}</span>
              <span class="stat-label">VOTI RICEVUTI</span>
            </div>
            <div class="stat-editorial-item">
              <span class="stat-number">{String(producer.stats.feedbackGiven).padStart(2, '0')}</span>
              <span class="stat-label">FEEDBACK FORNITI</span>
            </div>
            <div class="stat-editorial-item">
              <span class="stat-number">{String(producer.stats.challengesCompleted).padStart(2, '0')}</span>
              <span class="stat-label">CHALLENGE COMPLETATE</span>
            </div>
          </div>
        )}

        {/* USER TRACK HISTORY */}
        {isProducer && producer?.tracks && producer.tracks.length > 0 && (
          <div class="producer-tracks-section">
            <div class="section-title-row">
              <h2 class="tracks-title">Tracce & Produzioni</h2>
              <span class="tracks-count">{producer.tracks.length} brani</span>
            </div>
            <div class="producer-track-list">
              {producer.tracks.map((trk) => (
                <div class="producer-track-card">
                  {trk.audioUrl ? (
                    <audio class="track-audio-player" controls preload="none" src={trk.audioUrl} aria-label={`Ascolta ${trk.title}`} />
                  ) : (
                    <button class="track-play-btn" type="button" disabled aria-label={`Anteprima non disponibile per ${trk.title}`} title="Anteprima non disponibile">
                      ▶
                    </button>
                  )}
                  <div class="track-info-col">
                    <span class="track-title-text">{trk.title}</span>
                    <span class="track-meta-text">
                      {trk.bpm && <strong>{trk.bpm} BPM</strong>}
                      {trk.genre && <span> • {trk.genre}</span>}
                      {trk.duration && <span> • {trk.duration}</span>}
                    </span>
                  </div>
                  <div class="waveform-mockup-bars" aria-hidden="true">
                    <span style="height: 40%"></span>
                    <span style="height: 75%"></span>
                    <span style="height: 55%"></span>
                    <span style="height: 90%"></span>
                    <span style="height: 65%"></span>
                    <span style="height: 100%"></span>
                    <span style="height: 70%"></span>
                    <span style="height: 85%"></span>
                    <span style="height: 45%"></span>
                    <span style="height: 60%"></span>
                  </div>
                  <div class="track-votes-box">
                    <span class="vote-icon">▲</span>
                    <span class="vote-count">{trk.votes}</span>
                  </div>
                </div>
              ))}
            </div>
          </div>
        )}

        {/* ACHIEVEMENTS / RICONOSCIMENTI */}
        {isProducer && producer?.achievements && producer.achievements.length > 0 && (
          <div class="producer-achievements-section">
            <span class="achievements-title">Riconoscimenti & Milestone:</span>
            <div class="achievements-grid">
              {producer.achievements.map((ach) => (
                <div class="achievement-pill">
                  <span class="ach-icon">★</span>
                  <span>{ach}</span>
                </div>
              ))}
            </div>
          </div>
        )}

        <div class="article-separator"></div>

        {hasBody ? (
          <article class="article-body">
            {body.map((block) => (
              <section class="body-block">
                {block.heading && <h2>{block.heading}</h2>}
                <div class="block-html" set:html={block.html} />
              </section>
            ))}
          </article>
        ) : (
          <div class="article-fallback-body">
            <p>Scheda informativa del catalogo Drops. Per consultare tutti i dettagli completi, accedi direttamente alla fonte originale collegata nella colonna di sinistra.</p>
          </div>
        )}

        {item.relations && item.relations.length > 0 && (
          <div class="article-relations-box">
            <h3>Connessioni nel grafo:</h3>
            <ul>
              {item.relations.map((rel) => (
                <li>
                  <strong>{rel.label}</strong>
                  {rel.reason && <span> — {rel.reason}</span>}
                </li>
              ))}
            </ul>
          </div>
        )}

        {/* CALL TO ACTION HUB PER VISITATORI */}
        <div class="producer-academy-footer-cta">
          <div class="cta-left">
            <span class="badge-new-pill">DROPS ACADEMY</span>
            <h3>Fai musica anche tu?</h3>
            <p>Crea il tuo profilo producer, impara con i 4 moduli video e partecipa alle Monthly Challenge con i Guest Artist di Drops.</p>
          </div>
          <a href="/app/academy" class="primary-direct-cta" style="width: auto; padding: 0 1.5rem;">
            Entra nell'Academy ↗
          </a>
        </div>
      </section>
    </div>
  </main>
</PublicLayout>

<style>
  .track-audio-player {
    width: min(260px, 36vw);
    height: 36px;
  }
  .article-page-container {
    width: min(100%, 1240px);
    margin: 0 auto;
    padding: clamp(1rem, 2.5vw, 2rem) clamp(1rem, 3vw, 2.5rem) 5rem;
  }

  .article-layout-grid {
    display: grid;
    grid-template-columns: 360px minmax(0, 1fr);
    gap: clamp(2rem, 4vw, 4.5rem);
    align-items: start;
  }

  /* COLONNA SINISTRA STICKY */
  .article-sidebar-sticky {
    position: sticky;
    top: 90px;
    display: flex;
    flex-direction: column;
    gap: 1.1rem;
  }

  .back-to-catalog {
    font-size: 0.85rem;
    font-weight: 700;
    color: var(--color-text-muted, #626862);
    text-decoration: none;
    transition: color 0.15s;
    margin-bottom: 0.2rem;
  }
  .back-to-catalog:hover {
    color: var(--color-accent-strong, #15803d);
  }

  .article-cover-wrap {
    width: 100%;
    aspect-ratio: 4 / 5;
    border-radius: 16px;
    overflow: hidden;
    background: #151815;
    border: 1px solid var(--color-border, #dce1dc);
    box-shadow: 0 4px 14px rgba(0, 0, 0, 0.06);
  }

  .article-cover-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  .article-cover-fallback {
    width: 100%;
    height: 100%;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    padding: 1.25rem;
    background: linear-gradient(135deg, #18201a 0%, #0d120e 100%);
    border-left: 4px solid var(--color-accent, #22c55e);
  }

  .fallback-kicker {
    font-size: 0.8rem;
    font-weight: 800;
    text-transform: uppercase;
    letter-spacing: 0.12em;
    color: var(--color-accent, #22c55e);
  }

  .fallback-brand {
    font-size: 1.4rem;
    font-weight: 900;
    color: #ffffff;
    letter-spacing: -0.04em;
    opacity: 0.85;
  }

  /* PULSANTE PRINCIPALE DIRETTO */
  .primary-direct-cta {
    display: flex;
    align-items: center;
    justify-content: space-between;
    width: 100%;
    min-height: 52px;
    padding: 0 1.25rem;
    border-radius: 12px;
    background: var(--color-accent, #22c55e);
    color: #05230f;
    font-size: 0.98rem;
    font-weight: 800;
    text-decoration: none;
    box-shadow: 0 3px 12px rgba(34, 197, 94, 0.28);
    transition: transform 0.15s, box-shadow 0.15s, background 0.15s;
  }

  .primary-direct-cta:hover {
    background: #16a34a;
    color: #ffffff;
    transform: translateY(-2px);
    box-shadow: 0 6px 18px rgba(34, 197, 94, 0.38);
  }

  .cta-arrow {
    font-size: 1.2rem;
    font-weight: 900;
  }

  .sidebar-box {
    padding: 1.1rem;
    border: 1px solid var(--color-border, #dce1dc);
    border-radius: 14px;
    background: var(--color-surface, #ffffff);
  }

  .box-title {
    display: block;
    font-size: 0.75rem;
    font-weight: 800;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--color-text-muted, #626862);
    margin-bottom: 0.6rem;
  }

  .platforms-list {
    display: flex;
    flex-direction: column;
    gap: 0.4rem;
  }

  .source-chip {
    display: inline-flex;
    align-items: center;
    justify-content: space-between;
    padding: 0.45rem 0.75rem;
    border: 1px solid var(--color-border-strong, #c8cec8);
    border-radius: 8px;
    color: var(--color-text, #151815);
    background: var(--color-surface-subtle, #f2f4f1);
    font-size: 0.84rem;
    font-weight: 600;
    text-decoration: none;
    transition: all 0.15s;
  }

  .source-chip:hover {
    border-color: var(--color-accent-strong, #15803d);
    color: var(--color-accent-strong, #15803d);
    background: var(--color-accent-soft, #dcfce7);
  }

  .meta-list {
    display: flex;
    flex-direction: column;
    gap: 0.7rem;
    margin: 0;
  }

  .meta-list div {
    display: flex;
    flex-direction: column;
    gap: 0.15rem;
  }

  .meta-list dt {
    font-size: 0.72rem;
    font-weight: 800;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    color: var(--color-text-muted, #626862);
  }

  .meta-list dd {
    margin: 0;
    font-size: 0.88rem;
    font-weight: 600;
    color: var(--color-text, #151815);
  }

  .tags-row {
    color: var(--color-text-muted, #626862) !important;
    font-size: 0.82rem !important;
  }

  /* COLONNA DESTRA SCROLLABILE */
  .article-content-scrollable {
    min-width: 0;
    display: flex;
    flex-direction: column;
  }

  .article-kicker {
    display: inline-block;
    font-size: 0.82rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    font-weight: 800;
    color: var(--color-accent-strong, #15803d);
    margin-bottom: 0.75rem;
  }

  .article-headline {
    font-size: clamp(2rem, 3.2vw, 2.85rem);
    font-weight: 900;
    letter-spacing: -0.035em;
    line-height: 1.15;
    color: var(--color-text, #151815);
    margin: 0 0 1.25rem;
  }

  .article-standfirst {
    font-size: clamp(1.15rem, 1.4vw, 1.32rem);
    line-height: 1.6;
    color: #2b302b;
    font-weight: 500;
    margin: 0 0 1.75rem;
  }

  .article-separator {
    height: 1px;
    background: var(--color-border, #dce1dc);
    margin-bottom: 2.2rem;
  }

  .article-body {
    display: flex;
    flex-direction: column;
    gap: 2rem;
  }

  .body-block h2 {
    font-size: clamp(1.35rem, 1.8vw, 1.65rem);
    font-weight: 800;
    letter-spacing: -0.025em;
    line-height: 1.25;
    margin: 0 0 0.85rem;
    color: var(--color-text, #151815);
  }

  .block-html {
    font-size: 1.06rem;
    line-height: 1.75;
    color: #242924;
  }

  .block-html :global(p) {
    margin: 0 0 1.1rem;
  }

  .block-html :global(p.lead) {
    font-size: 1.16rem;
    line-height: 1.7;
    color: #121512;
    font-weight: 500;
  }

  .block-html :global(ul) {
    margin: 0.6rem 0 1.2rem;
    padding-left: 1.4rem;
  }

  .block-html :global(li) {
    margin-bottom: 0.45rem;
  }

  .block-html :global(a) {
    color: var(--color-accent-strong, #15803d);
    text-underline-offset: 3px;
    font-weight: 700;
  }

  .block-html :global(span.pop) {
    color: #b45309;
    font-weight: 700;
  }

  .article-relations-box {
    margin-top: 3rem;
    padding: 1.5rem;
    background: var(--color-surface-subtle, #f2f4f1);
    border: 1px solid var(--color-border, #dce1dc);
    border-radius: 14px;
  }

  .article-relations-box h3 {
    margin: 0 0 0.75rem;
    font-size: 0.95rem;
    font-weight: 800;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    color: var(--color-text, #151815);
  }

  .article-relations-box ul {
    margin: 0;
    padding-left: 1.2rem;
  }

  .article-relations-box li {
    margin-bottom: 0.4rem;
    font-size: 0.95rem;
    color: #333833;
  }

  /* RESPONSIVE LAYOUT */
  @media (max-width: 960px) {
    .article-layout-grid {
      grid-template-columns: minmax(0, 1fr);
      gap: 2.5rem;
    }

    .article-sidebar-sticky {
      position: static;
      max-width: 520px;
    }
  }
</style>
